  13:delay.cpp     **** Delay::Delay(float maxDelaySize, float delaySize, float wetMix, float sampleRate)
  14:delay.cpp     ****     : writeIndex(0)
  15:delay.cpp     ****     , sampleRate(sampleRate)
  16:delay.cpp     ****     , currentDelay(delaySize)
  17:delay.cpp     ****     , targetDelay(delaySize)
  18:delay.cpp     ****     , currentWet(wetMix)
  19:delay.cpp     ****     , targetWet(wetMix)
  20:delay.cpp     ****     , currentFB(0.0f)
  21:delay.cpp     ****     , targetFB(0.0f)
  22:delay.cpp     **** { 
  23:delay.cpp     ****     assert(maxDelaySize > 1.0f);
  24:delay.cpp     ****     assert(delaySize >= 1.0f && delaySize < maxDelaySize);
  25:delay.cpp     ****     assert(wetMix >= 0.0f && wetMix <= 1.0f);
  26:delay.cpp     ****     assert(sampleRate > 0.0f);
  27:delay.cpp     **** 
  28:delay.cpp     ****     //create buffer. +2 for interpolation and write
  29:delay.cpp     ****     bufferSize = static_cast<int>(std::ceil(maxDelaySize)) + 2;
  30:delay.cpp     ****     delayBuffer.assign(bufferSize, 0.0f);
  31:delay.cpp     **** 
  32:delay.cpp     ****     smooth = 1.0f - std::exp(-1.0f / (0.010f * sampleRate));
  33:delay.cpp     **** 
  34:delay.cpp     ****     feedbackLP.Init(sampleRate);
  35:delay.cpp     ****     feedbackLP.SetCutoff(4000.0f);
  36:delay.cpp     **** }
