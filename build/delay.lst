   7:OnePoleLP.h   ****         void Init(float sampleRate)
   8:OnePoleLP.h   ****         {
   9:OnePoleLP.h   ****             sampleRate_ = sampleRate;
  10:OnePoleLP.h   ****             state_ = 0.0f;
  11:OnePoleLP.h   ****             SetCutoff(1000.0f);
  12:OnePoleLP.h   ****         }
  13:OnePoleLP.h   **** 
  14:OnePoleLP.h   ****         void SetCutoff(float hz) 
  15:OnePoleLP.h   ****         {
  16:OnePoleLP.h   ****             const float maxHz = 0.45 * sampleRate_;
  17:OnePoleLP.h   ****             if (hz > maxHz) hz = maxHz;
  18:OnePoleLP.h   ****             if (hz < 1.0f) hz = 1.0f;
  19:OnePoleLP.h   **** 
  20:OnePoleLP.h   ****             //algorithm for one pole LPF. values cause a lag behind the actual input, losing high f
  21:OnePoleLP.h   ****             coeff_ = 1.0f - std::exp(-2.0f * 3.14159265f * hz / sampleRate_);
  22:OnePoleLP.h   ****          }
  23:OnePoleLP.h   **** 
  24:OnePoleLP.h   ****          float Process(float in)
  25:OnePoleLP.h   ****          {
  26:OnePoleLP.h   ****             //LPF. multiplies gap between filter and input by the calculated coeff
  27:OnePoleLP.h   ****             state_ += coeff_ * (in - state_);
  28:OnePoleLP.h   ****             return state_;
  29:OnePoleLP.h   ****          }
  30:OnePoleLP.h   **** 
