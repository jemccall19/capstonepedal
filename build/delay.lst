  38:delay.cpp     **** void Delay::Process(float* buf, size_t n)
  39:delay.cpp     **** {
  40:delay.cpp     ****     for (size_t i = 0; i < n; i++)
  41:delay.cpp     ****         buf[i] = ProcessSample(buf[i]);
  42:delay.cpp     **** }
  43:delay.cpp     **** 
  44:delay.cpp     **** float Delay::ProcessSample(float input)
  45:delay.cpp     **** {
  46:delay.cpp     ****     
  47:delay.cpp     ****     //smooth values
  48:delay.cpp     ****     currentDelay += smooth * (targetDelay - currentDelay);
  49:delay.cpp     ****     currentWet += smooth * (targetWet - currentWet);
  50:delay.cpp     ****     currentFB += smooth * (targetFB - currentFB);
  51:delay.cpp     **** 
  52:delay.cpp     ****     //read follows write by [delay size] num of samples
  53:delay.cpp     ****     float readPos = static_cast<float>(writeIndex) - currentDelay;
  54:delay.cpp     ****     if (readPos < 0.0f)
  55:delay.cpp     ****         readPos += bufferSize;
  56:delay.cpp     **** 
  57:delay.cpp     ****     //linear interpolation. don't ask me how it works
  58:delay.cpp     ****     int i0 = static_cast<int>(readPos);
  59:delay.cpp     ****     int i1 = (i0 + 1) % bufferSize;
  60:delay.cpp     ****     float frac = readPos - static_cast<float>(i0);
  61:delay.cpp     ****     float delayedSample = delayBuffer[i0] + frac * (delayBuffer[i1] - delayBuffer[i0]);
  62:delay.cpp     **** 
  63:delay.cpp     ****    
  64:delay.cpp     ****     //run feedback through LPF. tanh is for limiting (also don't ask me how that works)
  65:delay.cpp     ****     float filtered = feedbackLP.Process(delayedSample);
  66:delay.cpp     ****     float feedbackSample = std::tanh(filtered * currentFB);
  67:delay.cpp     **** 
  68:delay.cpp     ****     //write into the buffer, then wrap around if needed
ARM GAS  C:\Users\jemcc\AppData\Local\Temp\ccl20lrK.s 			page 4


  69:delay.cpp     ****     delayBuffer[writeIndex] = input + feedbackSample;
  70:delay.cpp     ****     writeIndex = (writeIndex + 1) % bufferSize;
  71:delay.cpp     **** 
  72:delay.cpp     ****     //output current sample, based on wet vs dry values
  73:delay.cpp     ****     return (1.0f - currentWet) * input + currentWet * delayedSample;
  74:delay.cpp     **** }
