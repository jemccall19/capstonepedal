   5:MonoReverb.h  **** #include "OnePoleHP.h"
   6:MonoReverb.h  **** 
   7:MonoReverb.h  **** // Mono reverb with the comb and allpass filters built into the class:
   8:MonoReverb.h  **** //   input -> low cut -> 4 input-diffusion allpasses -> 8 modulated combs
   9:MonoReverb.h  **** //         -> 4 modulated allpasses -> wet signal
  10:MonoReverb.h  **** //
  11:MonoReverb.h  **** // Everything is made from one primitive, ModDelay (a circular buffer with an
  12:MonoReverb.h  **** // LFO-wobbled, interpolated read). The comb and allpass math lives in
  13:MonoReverb.h  **** // runComb() and runAllpass() below.
  14:MonoReverb.h  **** class MonoReverb
  15:MonoReverb.h  **** {
  16:MonoReverb.h  **** public:
  17:MonoReverb.h  ****     MonoReverb(float wetMix, float sampleRate);
  18:MonoReverb.h  **** 
  19:MonoReverb.h  ****     float ProcessSample(float input);
  20:MonoReverb.h  ****     void reset();
  21:MonoReverb.h  ****     void setDecay(float newDecay);        // 0.0 to 1.0 (short room -> long hall)
  22:MonoReverb.h  ****     void setDamping(float cutoffHz);      // lowpass inside the comb loops
  23:MonoReverb.h  ****     void setWetMix(float newWetMix);      // 0.0 (dry) to 1.0 (wet)
  24:MonoReverb.h  ****     void setModDepth(float samples);      // 0.0 to ~6.0
  25:MonoReverb.h  ****     void setLowCut(float cutoffHz);       // highpass on the wet input, ~20 to 600 Hz
  26:MonoReverb.h  **** 
  27:MonoReverb.h  **** private:
  28:MonoReverb.h  ****     // Circular buffer with a fractional, LFO-modulated read position.
  29:MonoReverb.h  ****     // Call Read() then Write() exactly once per sample.
  30:MonoReverb.h  ****     struct ModDelay
  31:MonoReverb.h  ****     {
  32:MonoReverb.h  ****         void Init(int lengthSamples, float sampleRate, float lfoRateHz,
  33:MonoReverb.h  ****                   float startPhase, float maxDepth)
  34:MonoReverb.h  ****         {
  35:MonoReverb.h  ****             baseLength = static_cast<float>(lengthSamples);
  36:MonoReverb.h  ****             maxDepth_  = maxDepth;
  37:MonoReverb.h  ****             depth      = maxDepth;
  38:MonoReverb.h  **** 
  39:MonoReverb.h  ****             size = lengthSamples + static_cast<int>(std::ceil(maxDepth)) + 3;
  40:MonoReverb.h  ****             buffer.assign(size, 0.0f);
  41:MonoReverb.h  ****             writeIndex = 0;
  42:MonoReverb.h  **** 
  43:MonoReverb.h  ****             phase    = startPhase;
  44:MonoReverb.h  ****             phaseInc = lfoRateHz / sampleRate;
  45:MonoReverb.h  ****         }
  46:MonoReverb.h  **** 
  47:MonoReverb.h  ****         void SetDepth(float samples)
  48:MonoReverb.h  ****         {
  49:MonoReverb.h  ****             depth = samples < 0.0f ? 0.0f : (samples > maxDepth_ ? maxDepth_ : samples);
  50:MonoReverb.h  ****         }
  51:MonoReverb.h  **** 
  52:MonoReverb.h  ****         float Read()
  53:MonoReverb.h  ****         {
  54:MonoReverb.h  ****             // Advance the LFO (cheap parabolic sine approximation, -1..1)
  55:MonoReverb.h  ****             phase += phaseInc;
  56:MonoReverb.h  ****             if (phase >= 1.0f) phase -= 1.0f;
