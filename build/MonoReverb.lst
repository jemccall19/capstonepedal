   4:MonoReverb.cpp **** 
   5:MonoReverb.cpp **** namespace
   6:MonoReverb.cpp **** {
   7:MonoReverb.cpp ****     // Tunings are specified at 44.1 kHz and scaled to the actual sample rate.
   8:MonoReverb.cpp ****     const int combTuning[8]     = {1116, 1188, 1277, 1356, 1422, 1491, 1557, 1617};
   9:MonoReverb.cpp ****     const int allpassTuning[4]  = {556, 441, 341, 225};
  10:MonoReverb.cpp ****     const int diffuserTuning[4] = {210, 159, 562, 410};
  11:MonoReverb.cpp **** 
  12:MonoReverb.cpp ****     const float kInputGain   = 0.015f;   // 8 combs add together, so scale the input down
  13:MonoReverb.cpp ****     const float kWetScale    = 3.0f;
  14:MonoReverb.cpp ****     const float kAllpassGain = 0.5f;
  15:MonoReverb.cpp **** 
  16:MonoReverb.cpp ****     const float kCombMaxDepth    = 6.0f;
  17:MonoReverb.cpp ****     const float kAllpassMaxDepth = 4.0f;
  18:MonoReverb.cpp **** 
  19:MonoReverb.cpp ****     inline float clampf(float v, float lo, float hi)
  20:MonoReverb.cpp ****     {
  21:MonoReverb.cpp ****         return v < lo ? lo : (v > hi ? hi : v);
  22:MonoReverb.cpp ****     }
  23:MonoReverb.cpp **** }
  24:MonoReverb.cpp **** 
  25:MonoReverb.cpp **** MonoReverb::MonoReverb(float wetMix, float sampleRate)
  26:MonoReverb.cpp ****     : sampleRate(sampleRate)
  27:MonoReverb.cpp ****     , currentWet(wetMix)
  28:MonoReverb.cpp ****     , targetWet(wetMix)
  29:MonoReverb.cpp **** {
ARM GAS  C:\Users\jemcc\AppData\Local\Temp\ccDi22uD.s 			page 2


  30:MonoReverb.cpp ****     assert(wetMix >= 0.0f && wetMix <= 1.0f);
  31:MonoReverb.cpp ****     assert(sampleRate > 0.0f);
  32:MonoReverb.cpp **** 
  33:MonoReverb.cpp ****     const float scale = sampleRate / 44100.0f;
  34:MonoReverb.cpp **** 
  35:MonoReverb.cpp ****     // Input diffusion: no modulation (rate 0, depth 0)
  36:MonoReverb.cpp ****     for (int i = 0; i < kNumDiffusers; i++)
  37:MonoReverb.cpp ****         diffusers[i].Init(static_cast<int>(diffuserTuning[i] * scale),
  38:MonoReverb.cpp ****                           sampleRate, 0.0f, 0.0f, 0.0f);
  39:MonoReverb.cpp **** 
  40:MonoReverb.cpp ****     // Each comb/allpass gets its own LFO rate and starting phase so they never move in sync
  41:MonoReverb.cpp ****     for (int i = 0; i < kNumCombs; i++)
  42:MonoReverb.cpp ****     {
  43:MonoReverb.cpp ****         float rate  = 0.35f + 0.13f * i;                       // 0.35 .. 1.26 Hz
  44:MonoReverb.cpp ****         float phase = static_cast<float>(i) / kNumCombs;
  45:MonoReverb.cpp ****         combDelays[i].Init(static_cast<int>(combTuning[i] * scale), sampleRate,
  46:MonoReverb.cpp ****                            rate, phase, kCombMaxDepth);
  47:MonoReverb.cpp ****         combDamp[i].Init(sampleRate);
  48:MonoReverb.cpp ****     }
  49:MonoReverb.cpp **** 
  50:MonoReverb.cpp ****     for (int i = 0; i < kNumAllpass; i++)
  51:MonoReverb.cpp ****     {
  52:MonoReverb.cpp ****         float rate  = 0.50f + 0.17f * i;                       // 0.50 .. 1.01 Hz
  53:MonoReverb.cpp ****         float phase = (static_cast<float>(i) + 0.5f) / kNumAllpass;
  54:MonoReverb.cpp ****         allpasses[i].Init(static_cast<int>(allpassTuning[i] * scale), sampleRate,
  55:MonoReverb.cpp ****                           rate, phase, kAllpassMaxDepth);
  56:MonoReverb.cpp ****     }
  57:MonoReverb.cpp **** 
  58:MonoReverb.cpp ****     smoothCoeff = 1.0f - std::exp(-1.0f / (0.030f * sampleRate));
  59:MonoReverb.cpp **** 
  60:MonoReverb.cpp ****     lowCutA.Init(sampleRate);
  61:MonoReverb.cpp ****     lowCutB.Init(sampleRate);
  62:MonoReverb.cpp ****     setLowCut(200.0f);
  63:MonoReverb.cpp **** 
  64:MonoReverb.cpp ****     setDecay(0.5f);
  65:MonoReverb.cpp ****     setDamping(6000.0f);
  66:MonoReverb.cpp ****     setModDepth(3.0f);
  67:MonoReverb.cpp **** }
