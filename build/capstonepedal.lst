  60:capstonepedal.cpp **** 		out[0][i] = sig;
  61:capstonepedal.cpp **** 		out[1][i] = sig;
  62:capstonepedal.cpp **** 		
  63:capstonepedal.cpp **** 	}
  64:capstonepedal.cpp **** }
