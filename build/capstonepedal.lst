  38:capstonepedal.cpp **** void AudioCallback(AudioHandle::InputBuffer in, AudioHandle::OutputBuffer out, size_t size)
  39:capstonepedal.cpp **** {
  40:capstonepedal.cpp **** 	//calculate & update pot/param values
  41:capstonepedal.cpp **** 	ProcessADC();
  42:capstonepedal.cpp **** 	crush.SetBits(p2);
  43:capstonepedal.cpp **** 	crush.SetDownsample(p1);
