  63:bitcrusher.h  **** 
  64:bitcrusher.h  ****     // 0 = dry only, 1 = crushed only
  65:bitcrusher.h  ****     void SetMix(float mix)
  66:bitcrusher.h  ****     {
  67:bitcrusher.h  ****         if (mix < 0.0f) mix = 0.0f;
  68:bitcrusher.h  ****         if (mix > 1.0f) mix = 1.0f;
  69:bitcrusher.h  ****         mix_ = mix;
  70:bitcrusher.h  ****     }
  71:bitcrusher.h  **** 
  72:bitcrusher.h  ****     float ProcessSample(float in)
  73:bitcrusher.h  ****     {
  74:bitcrusher.h  ****         // Sample-rate reduction: grab a new sample only every `factor_` samples,
  75:bitcrusher.h  ****         // otherwise keep repeating the last one.
  76:bitcrusher.h  ****         counter_ += 1.0f;
  77:bitcrusher.h  ****         if (counter_ >= factor_)
  78:bitcrusher.h  ****         {
  79:bitcrusher.h  ****             counter_ -= factor_;
  80:bitcrusher.h  **** 
  81:bitcrusher.h  ****             // Input gain, then clip so the quantizer never sees values beyond +/-1
  82:bitcrusher.h  ****             float x = in * inGain_;
  83:bitcrusher.h  ****             if (x >  1.0f) x =  1.0f;
  84:bitcrusher.h  ****             if (x < -1.0f) x = -1.0f;
  85:bitcrusher.h  **** 
  86:bitcrusher.h  ****             // Bit-depth reduction: snap the sample to the nearest of a limited set of levels
  87:bitcrusher.h  ****             held_ = std::round(x * steps_) / steps_;
  88:bitcrusher.h  ****         }
  89:bitcrusher.h  **** 
  90:bitcrusher.h  ****         // Post lowpass smooths the staircase and tames the harsh high frequencies
  91:bitcrusher.h  ****         float wet = lpOn_ ? lp_.Process(held_) : held_;
  92:bitcrusher.h  ****         wet *= outGain_;
  93:bitcrusher.h  **** 
  94:bitcrusher.h  ****         // The dry path is the original, unprocessed input
  95:bitcrusher.h  ****         return (1.0f - mix_) * in + mix_ * wet;
  96:bitcrusher.h  ****     }
