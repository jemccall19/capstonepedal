  36:capstonepedal.cpp **** void AudioCallback(AudioHandle::InputBuffer in, AudioHandle::OutputBuffer out, size_t size)
  37:capstonepedal.cpp **** {
  38:capstonepedal.cpp **** 	//calculate & update pot/param values
  39:capstonepedal.cpp **** 	ProcessADC();
  40:capstonepedal.cpp **** 	delay.setDelaySize(p1);
  41:capstonepedal.cpp **** 	delay.setFeedback(p2);
  42:capstonepedal.cpp **** 	monoReverb.setDecay(0.5f);
  43:capstonepedal.cpp **** 	monoReverb.setModDepth(3.0f);
  44:capstonepedal.cpp **** 	monoReverb.setLowCut(200.0f);
  45:capstonepedal.cpp **** 
  46:capstonepedal.cpp **** 	for (size_t i = 0; i < size; i++)
  47:capstonepedal.cpp **** 	{
  48:capstonepedal.cpp **** 		//signal path
  49:capstonepedal.cpp **** 		float sig = in[1][i];
  50:capstonepedal.cpp **** 		sig = delay.ProcessSample(sig);
  51:capstonepedal.cpp **** 		sig = monoReverb.ProcessSample(sig);
  52:capstonepedal.cpp **** 		out[0][i] = sig;
  53:capstonepedal.cpp **** 		out[1][i] = sig;
  54:capstonepedal.cpp **** 		
  55:capstonepedal.cpp **** 	}
  56:capstonepedal.cpp **** }
