  24:bitcrusher.h  **** 
  25:bitcrusher.h  ****     // bits: 1 (harsh) to 16 (clean). Fractional values work, so a knob can sweep smoothly.
  26:bitcrusher.h  ****     void SetBits(float bits)
  27:bitcrusher.h  ****     {
  28:bitcrusher.h  ****         if (bits < 1.0f)  bits = 1.0f;
  29:bitcrusher.h  ****         if (bits > 16.0f) bits = 16.0f;
  30:bitcrusher.h  ****         steps_ = std::exp2(bits - 1.0f);   // quantization levels per side of zero
  31:bitcrusher.h  ****     }
  32:bitcrusher.h  **** 
  33:bitcrusher.h  ****     // factor: 1 = no reduction, 2 = hold each sample for 2 samples (half rate), etc.
  34:bitcrusher.h  ****     // Fractional values work.
  35:bitcrusher.h  ****     void SetDownsample(float factor)
  36:bitcrusher.h  ****     {
  37:bitcrusher.h  ****         if (factor < 1.0f) factor = 1.0f;
  38:bitcrusher.h  ****         factor_ = factor;
  39:bitcrusher.h  ****     }
  40:bitcrusher.h  **** 
  41:bitcrusher.h  ****     // Gain applied before the crush (linear, 1.0 = unchanged). Above 1.0 pushes the signal
  42:bitcrusher.h  ****     // harder into the quantizer and clips at +/-1, which adds drive.
  43:bitcrusher.h  ****     void SetInputGain(float gain)
  44:bitcrusher.h  ****     {
  45:bitcrusher.h  ****         inGain_ = gain < 0.0f ? 0.0f : gain;
  46:bitcrusher.h  ****     }
  47:bitcrusher.h  **** 
  48:bitcrusher.h  ****     // Gain applied to the crushed signal (linear, 1.0 = unchanged), after the lowpass.
  49:bitcrusher.h  ****     // Use it to bring the level back down after boosting the input.
  50:bitcrusher.h  ****     void SetOutputGain(float gain)
  51:bitcrusher.h  ****     {
  52:bitcrusher.h  ****         outGain_ = gain < 0.0f ? 0.0f : gain;
  53:bitcrusher.h  ****     }
  54:bitcrusher.h  **** 
