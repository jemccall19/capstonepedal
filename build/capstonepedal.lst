   7:MonoReverb.h  **** // Mono reverb with the comb and allpass filters built into the class:
   8:MonoReverb.h  **** //   input -> low cut -> 4 input-diffusion allpasses -> 8 modulated combs
   9:MonoReverb.h  **** //         -> 4 modulated allpasses -> wet signal
  10:MonoReverb.h  **** //
  11:MonoReverb.h  **** // Everything is made from one primitive, ModDelay (a circular buffer with an
  12:MonoReverb.h  **** // LFO-wobbled, interpolated read). The comb and allpass math lives in
  13:MonoReverb.h  **** // runComb() and runAllpass() below.
  14:MonoReverb.h  **** class MonoReverb
